{
  "manifest_version": 3,
  "name": "Cline Perchance Agent Bridge",
  "version": "2.0.0",
  "description": "Bridges Perchance AI Agent with local proxy (port 8010) for Cline and coding agents.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://*.perchance.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.perchance.org/*"],
      "all_frames": false,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Cline Perchance Agent Bridge", "default_popup": "popup.html" }
}
