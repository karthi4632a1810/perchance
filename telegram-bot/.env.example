# Telegram bot settings. This file holds secrets: never share it or commit it.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram sends this with every update so webhook.php knows the request is real.
# setup.php also asks for it. Any 1-256 letters, digits, _ or -.
TELEGRAM_WEBHOOK_SECRET=

# Who may use the bot: Telegram user IDs or @usernames, comma-separated, or * for everyone.
# Empty: the first person to message the bot becomes its owner and everyone else is refused.
TELEGRAM_ALLOWED_USERS=

# Key for the JSON chat API (api.php). Leave empty to turn api.php off.
API_KEY=

# How the bot behaves
BOT_SYSTEM_PROMPT=You are a helpful, friendly assistant chatting with the user on Telegram. Answer clearly and concisely, in the language the user writes in. Use Markdown for code.

# Perchance session (same values as the local proxy's .env)
PERCHANCE_USER_KEY=
PERCHANCE_BROWSER_ID=
PERCHANCE_CF_CLEARANCE=
PERCHANCE_USER_AGENT=

# Image generation (/image command)
PERCHANCE_IMAGE_USER_KEY=
PERCHANCE_AD_ACCESS_CODE=

# Optional
# PERCHANCE_MAX_CONTINUES=3
# HISTORY_MAX_CHARS=12000
# KNOWLEDGE_MAX_CHARS=15000
# PERCHANCE_IMAGE_ALLOW_NSFW=false

# Perchance requests are made by the Perchance Bridge Chrome extension in your browser,
# because Perchance only accepts a key from the browser and IP address that verified it.
PERCHANCE_VIA=bridge
# The extension's key (also in perchance-bridge-extension/config.js)
BRIDGE_KEY=
