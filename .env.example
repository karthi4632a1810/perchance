# Copy to .env and fill in from Chrome DevTools on https://perchance.org/ai-code-generator
# (Network tab > the "generate?..." request). Values in .env are re-read on every request.

# Payload > Query string parameters > userKey
PERCHANCE_USER_KEY=
# Payload > Query string parameters > browserId
PERCHANCE_BROWSER_ID=
# Cookies tab > cf_clearance
PERCHANCE_CF_CLEARANCE=
# Headers > Request headers > User-Agent (must be the browser that got cf_clearance)
PERCHANCE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36

# Optional
# PERCHANCE_GENERATOR=ai-code-generator
# PERCHANCE_TIMEOUT=300
# Extra requests allowed for one long reply (Perchance cuts each one at 1024 tokens or less)
# PERCHANCE_MAX_CONTINUES=24
# Prompt + reply so far allowed in one request (Perchance errors at about 52,500 characters)
# PERCHANCE_MAX_INPUT_CHARS=46000
